---
import "@/styles/global.css";
import type { LangKey } from "@/i18n";
import { t, languages, langPath, docsPath } from "@/i18n";

interface Props {
  lang: LangKey;
}

const { lang } = Astro.props;
const i = t(lang);
---

<!doctype html>
<html lang={i.meta.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{i.meta.title}</title>
    <meta name="description" content={i.meta.description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta property="og:title" content={i.meta.title} />
    <meta property="og:description" content={i.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://oxideterm.app${langPath(lang)}`} />
    <meta property="og:image" content="https://oxideterm.app/images/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="site-body">
    <!-- The edge-aligned navigation matches the small set of real destinations. -->
    <nav class="site-nav">
      <div class="site-nav__inner">
        <a href={langPath(lang)} class="site-wordmark">
          <span>Oxide</span><span class="site-wordmark__signal">Term</span>
        </a>

        <div class="site-nav__links">
          <a href={docsPath(lang)} class="site-nav__link">{i.footer.docs}</a>
          <a href="https://github.com/AnalyseDeCircuit/oxideterm" class="site-nav__link">GitHub</a>

          <div class="site-language" id="lang-selector">
            <button
              id="lang-btn"
              class="site-language__trigger"
              aria-label={i.footer.language}
              aria-expanded="false"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </button>
            <div id="lang-menu" class="site-language__menu hidden">
              {languages.map((language) => (
                <a
                  href={langPath(language.key)}
                  class:list={[
                    "site-language__option",
                    language.key === lang && "site-language__option--active",
                  ]}
                >
                  {language.label}
                </a>
              ))}
            </div>
          </div>

          <a href="#download" class="site-nav__cta">{i.hero.cta_download}</a>
        </div>

        <button
          id="mobile-menu-btn"
          class="site-nav__menu-button"
          aria-label="Menu"
          aria-expanded="false"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        </button>
      </div>

      <div id="mobile-menu" class="site-mobile-nav hidden">
        <div class="site-mobile-nav__inner">
          <a href={docsPath(lang)} class="site-mobile-nav__link">{i.footer.docs}</a>
          <a href="https://github.com/AnalyseDeCircuit/oxideterm" class="site-mobile-nav__link">GitHub</a>
          <details class="site-mobile-nav__languages">
            <summary>{i.footer.language}</summary>
            <div class="site-mobile-nav__language-list">
              {languages.map((language) => (
                <a
                  href={langPath(language.key)}
                  class:list={[
                    "site-mobile-nav__link",
                    language.key === lang && "site-mobile-nav__link--active",
                  ]}
                >
                  {language.label}
                </a>
              ))}
            </div>
          </details>
          <a href="#download" class="site-nav__cta">{i.hero.cta_download}</a>
        </div>
      </div>
    </nav>

    <script>
      const mobileButton = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      const languageButton = document.getElementById("lang-btn");
      const languageMenu = document.getElementById("lang-menu");

      mobileButton?.addEventListener("click", () => {
        const nowHidden = mobileMenu?.classList.toggle("hidden") ?? true;
        mobileButton.setAttribute("aria-expanded", String(!nowHidden));
      });

      languageButton?.addEventListener("click", (event) => {
        event.stopPropagation();
        const nowHidden = languageMenu?.classList.toggle("hidden") ?? true;
        languageButton.setAttribute("aria-expanded", String(!nowHidden));
      });

      document.addEventListener("click", () => {
        languageMenu?.classList.add("hidden");
        languageButton?.setAttribute("aria-expanded", "false");
      });
    </script>

    <main class="site-main">
      <slot />
    </main>
  </body>
</html>
