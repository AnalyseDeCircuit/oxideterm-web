---
import type { LangKey } from "@/i18n";
import { t } from "@/i18n";
import { icon } from "@/lib/icons";

interface Props {
  lang: LangKey;
}

const { lang } = Astro.props;
const i = t(lang);

const accent = "var(--ot-accent)";
const s = { size: 18, stroke: accent };
const sections = [
  { icon: icon("globe", s), title: i.legal.network_title, desc: i.legal.network_desc },
  { icon: icon("bot", s), title: i.legal.ai_title, desc: i.legal.ai_desc },
  { icon: icon("lock", s), title: i.legal.data_title, desc: i.legal.data_desc },
  { icon: icon("scales", s), title: i.legal.license_title, desc: i.legal.license_desc },
];
---

<section class="site-section legal-ledger">
  <div class="section-shell section-shell--reading">
    <p class="section-head__label">
      {i.legal.badge}
    </p>
    <div class="legal-ledger__title">
      <span aria-hidden="true" set:html={icon("shieldCheck", { size: 22, stroke: accent })} />
      <h2>
        {i.legal.title}
      </h2>
    </div>
    <p class="legal-ledger__subtitle">
      {i.legal.subtitle}
    </p>

    <div class="legal-ledger__items">
      {sections.map((section) => (
        <div class="legal-ledger__item">
          <div class="legal-ledger__item-inner">
            <span aria-hidden="true" set:html={section.icon} />
            <div>
              <h3>
                {section.title}
              </h3>
              <p>
                {section.desc}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <p class="legal-ledger__disclaimer">
      {i.legal.disclaimer}
    </p>
  </div>
</section>
