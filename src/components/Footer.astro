---
import type { LangKey } from "@/i18n";
import { t, languages, langPath, docsPath } from "@/i18n";

interface Props {
  lang: LangKey;
}

const { lang } = Astro.props;
const i = t(lang);
---

<footer class="site-footer">
  <div class="section-shell">
    <div class="site-footer__primary">
      <div class="site-footer__brand">
        <div class="site-wordmark">
          <span>Oxide</span><span class="site-wordmark__signal">Term</span>
        </div>
        <p>{i.hero.tagline}</p>
      </div>

      <div class="site-footer__group">
        <h4>{i.footer.links}</h4>
        <nav class="site-footer__links">
          <a href="https://github.com/AnalyseDeCircuit/oxideterm">{i.footer.source}</a>
          <a href={docsPath(lang)}>{i.footer.docs}</a>
          <a href="https://github.com/AnalyseDeCircuit/oxideterm/releases">{i.footer.releases}</a>
        </nav>
      </div>

      <div class="site-footer__legal">
        <h4>{i.footer.legal}</h4>
        <p>{i.footer.license}</p>
        <a href="https://www.gnu.org/licenses/gpl-3.0.html">{i.footer.license_link}</a>
      </div>
    </div>

    <div class="site-footer__group site-footer__group--languages">
      <h4>{i.footer.language}</h4>
      <nav class="site-footer__languages">
        {languages.map((language) => (
          <a
            href={langPath(language.key)}
            class:list={[language.key === lang && "site-footer__language--active"]}
          >
            {language.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="site-footer__meta">
      <span>© {new Date().getFullYear()} OxideTerm</span>
      <span>{i.footer.built_with}</span>
    </div>
  </div>
</footer>
