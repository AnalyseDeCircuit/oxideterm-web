---
import type { LangKey } from "@/i18n";
import { t } from "@/i18n";

interface Props {
  lang: LangKey;
}

const { lang } = Astro.props;
const i = t(lang);
---

<section class="site-section product-demo">
  <div class="section-shell section-shell--reading">
    <div class="section-head section-head--split">
    <p class="section-head__label">
      {i.demo.badge}
    </p>
    <div>
    <h2>
      {i.demo.title}
    </h2>
    <p>
      {i.demo.subtitle}
    </p>
    </div>
    </div>

    <figure class="demo-video-container">
      <video
        class="product-demo__video"
        controls
        preload="metadata"
        playsinline
        poster="/images/screenshots/overview.png"
        width="1280"
        height="720"
      >
        <source
          src="/videos/demo.mp4"
          type="video/mp4"
        />
        {i.demo.fallback}
      </video>
    </figure>
  </div>
</section>
