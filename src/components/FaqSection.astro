---
import type { LangKey } from "@/i18n";
import { t } from "@/i18n";

interface Props {
  lang: LangKey;
}

const { lang } = Astro.props;
const i = t(lang);

const items = [
  { q: i.faq.q1, a: i.faq.a1 },
  { q: i.faq.q2, a: i.faq.a2 },
  { q: i.faq.q3, a: i.faq.a3 },
  { q: i.faq.q4, a: i.faq.a4 },
  { q: i.faq.q5, a: i.faq.a5 },
  { q: i.faq.q6, a: i.faq.a6 },
];
---

<section class="site-section faq-ledger">
  <div class="section-shell section-shell--reading">
    <div class="section-head section-head--compact">
    <p class="section-head__label">
      {i.faq.badge}
    </p>
    <h2>
      {i.faq.title}
    </h2>
    </div>

    <div class="faq-ledger__items">
      {items.map((item) => (
        <details class="faq-item group">
          <summary>
            <span>{item.q}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="faq-item__chevron group-open:rotate-180"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </summary>
          <div class="faq-item__answer">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
