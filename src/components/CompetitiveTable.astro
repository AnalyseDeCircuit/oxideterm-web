---
import type { LangKey } from "@/i18n";
import { t } from "@/i18n";

interface Props {
  lang: LangKey;
}

const { lang } = Astro.props;
const i = t(lang);
const c = i.competitive;

const Y = c.yes;
const N = c.no;
const P = c.partial;
const V = c.varies;

// Product categories are intentionally generic because individual tools vary.
const rows: { label: string; ot: string; cross: string; ssh: string; toolbox: string; ide: string }[] = [
  { label: c.row_cross_platform, ot: c.val_platform_ot, cross: V, ssh: V, toolbox: V, ide: V },
  { label: c.row_binary_size, ot: c.val_binary_ot, cross: V, ssh: V, toolbox: V, ide: V },
  { label: c.row_ui_runtime, ot: c.val_runtime_ot, cross: c.val_runtime_browser, ssh: c.val_runtime_native, toolbox: c.val_runtime_native, ide: c.val_runtime_browser },
  { label: c.row_ssh_impl, ot: c.val_ssh_ot, cross: c.val_ssh_builtin, ssh: c.val_ssh_builtin, toolbox: c.val_ssh_builtin, ide: c.val_ssh_system },
  { label: c.row_local_terminal, ot: Y, cross: Y, ssh: Y, toolbox: Y, ide: Y },
  { label: c.row_builtin_sftp, ot: Y, cross: Y, ssh: P, toolbox: Y, ide: N },
  { label: c.row_forwarding, ot: Y, cross: Y, ssh: Y, toolbox: Y, ide: Y },
  { label: c.row_builtin_ide, ot: Y, cross: N, ssh: N, toolbox: P, ide: Y },
  { label: c.row_remote_desktop, ot: Y, cross: N, ssh: N, toolbox: Y, ide: N },
  { label: c.row_ai, ot: Y, cross: N, ssh: N, toolbox: N, ide: Y },
  { label: c.row_reconnect, ot: Y, cross: N, ssh: N, toolbox: N, ide: P },
  { label: c.row_multiplex, ot: Y, cross: V, ssh: V, toolbox: V, ide: P },
  { label: c.row_plugin, ot: Y, cross: Y, ssh: N, toolbox: Y, ide: Y },
  { label: c.row_i18n, ot: Y, cross: Y, ssh: Y, toolbox: Y, ide: Y },
  { label: c.row_open_source, ot: Y, cross: Y, ssh: N, toolbox: N, ide: P },
  { label: c.row_free, ot: Y, cross: Y, ssh: P, toolbox: P, ide: Y },
];
---

<section class="py-20 px-6 border-t border-[var(--ot-border)]">
  <div class="max-w-4xl mx-auto">
    <p class="text-xs font-semibold uppercase tracking-wider text-[var(--ot-accent)] text-center mb-3">
      {c.badge}
    </p>
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-3 tracking-tight">
      {c.title}
    </h2>
    <p class="text-center text-[var(--ot-text-muted)] mb-14 max-w-xl mx-auto">
      {c.subtitle}
    </p>

    <div class="overflow-x-auto rounded-xl border border-[var(--ot-border)]">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-[var(--ot-bg-elevated)]">
            <th class="text-left px-5 py-4 font-medium text-[var(--ot-text-muted)] min-w-[180px]">
              {c.col_feature}
            </th>
            <th class="text-center px-5 py-4 font-bold text-[var(--ot-accent)] min-w-[140px]">
              {c.col_oxideterm}
            </th>
            <th class="text-center px-5 py-4 font-medium text-[var(--ot-text-secondary)] min-w-[140px]">
              {c.col_cross_platform_terminal}
            </th>
            <th class="text-center px-5 py-4 font-medium text-[var(--ot-text-secondary)] min-w-[140px]">
              {c.col_professional_ssh}
            </th>
            <th class="text-center px-5 py-4 font-medium text-[var(--ot-text-secondary)] min-w-[140px]">
              {c.col_remote_toolbox}
            </th>
            <th class="text-center px-5 py-4 font-medium text-[var(--ot-text-secondary)] min-w-[140px]">
              {c.col_remote_ide}
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row, idx) => (
            <tr class:list={[
              "border-t border-[var(--ot-border-subtle)]",
              idx % 2 === 0 ? "bg-[var(--ot-bg-base)]" : "bg-[var(--ot-bg-surface)]"
            ]}>
              <td class="px-5 py-3.5 font-medium text-[var(--ot-text-primary)]">
                {row.label}
              </td>
              <td class:list={[
                "px-5 py-3.5 text-center",
                row.ot === Y ? "text-[var(--ot-green)] font-bold text-base" : "text-[var(--ot-text-secondary)] text-xs"
              ]}>
                {row.ot}
              </td>
              <td class:list={[
                "px-5 py-3.5 text-center",
                row.cross === Y ? "text-[var(--ot-green)] font-bold text-base"
                  : row.cross === N ? "text-[var(--ot-text-muted)]"
                  : "text-[var(--ot-text-secondary)] text-xs"
              ]}>
                {row.cross}
              </td>
              <td class:list={[
                "px-5 py-3.5 text-center",
                row.ssh === Y ? "text-[var(--ot-green)] font-bold text-base"
                  : row.ssh === N ? "text-[var(--ot-text-muted)]"
                  : "text-[var(--ot-text-secondary)] text-xs"
              ]}>
                {row.ssh}
              </td>
              <td class:list={[
                "px-5 py-3.5 text-center",
                row.toolbox === Y ? "text-[var(--ot-green)] font-bold text-base"
                  : row.toolbox === N ? "text-[var(--ot-text-muted)]"
                  : "text-[var(--ot-text-secondary)] text-xs"
              ]}>
                {row.toolbox}
              </td>
              <td class:list={[
                "px-5 py-3.5 text-center",
                row.ide === Y ? "text-[var(--ot-green)] font-bold text-base"
                  : row.ide === N ? "text-[var(--ot-text-muted)]"
                  : "text-[var(--ot-text-secondary)] text-xs"
              ]}>
                {row.ide}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="text-xs text-[var(--ot-text-muted)] text-center mt-6 max-w-lg mx-auto leading-relaxed">
      {c.note}
    </p>
  </div>
</section>
