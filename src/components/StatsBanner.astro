---
import type { LangKey } from "@/i18n";
import { t } from "@/i18n";

interface Props {
  lang: LangKey;
}

const { lang } = Astro.props;
const i = t(lang);

const stats = [
  { value: i.stats.memory_value, label: i.stats.memory_label },
  { value: i.stats.binary_value, label: i.stats.binary_label },
  { value: i.stats.reconnect_value, label: i.stats.reconnect_label },
  { value: i.stats.ssh_value, label: i.stats.ssh_label },
];
---

<section class="stats-rail">
  <div class="section-shell">
    <div class="stats-rail__grid">
      {stats.map((stat) => (
        <div class="stats-rail__item">
          <div class="stats-rail__value stat-number">
            {stat.value}
          </div>
          <div class="stats-rail__label">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
