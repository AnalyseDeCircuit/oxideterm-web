---
import type { LangKey } from "@/i18n";
import { t } from "@/i18n";
import { icon } from "@/lib/icons";

interface Props {
  lang: LangKey;
}

const { lang } = Astro.props;
const i = t(lang);

const accent = "var(--ot-accent)";
const s = { size: 32, stroke: accent };
const cards = [
  { icon: icon("lock", s), title: i.security.encryption_title, desc: i.security.encryption_desc },
  { icon: icon("filePhoto", s), title: i.security.keychain_title, desc: i.security.keychain_desc },
  { icon: icon("shield", s), title: i.security.ssh_title, desc: i.security.ssh_desc },
  { icon: icon("biometric", s), title: i.security.biometric_title, desc: i.security.biometric_desc },
  { icon: icon("shieldCheck", s), title: i.security.zeroize_title, desc: i.security.zeroize_desc },
  { icon: icon("key", s), title: i.security.ws_token_title, desc: i.security.ws_token_desc },
];
---

<section class="site-section security-spec">
  <div class="section-shell">
    <div class="section-head section-head--split">
    <p class="section-head__label">
      {i.security.badge}
    </p>
    <div>
    <h2>
      {i.security.title}
    </h2>
    <p>
      {i.security.subtitle}
    </p>
    </div>
    </div>

    <div class="security-spec__grid">
      {cards.map((card) => (
        <div class="security-spec__item">
          <div class="security-spec__icon" aria-hidden="true" set:html={card.icon} />
          <h3>
            {card.title}
          </h3>
          <p>
            {card.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
