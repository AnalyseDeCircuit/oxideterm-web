---
import type { LangKey } from "@/i18n";
import { t } from "@/i18n";
import { icon } from "@/lib/icons";

interface Props {
  lang: LangKey;
}

const { lang } = Astro.props;
const i = t(lang);

const accent = "var(--ot-accent)";
const features = [
  {
    id: "terminal",
    title: i.details.terminal_title,
    items: [i.details.terminal_1, i.details.terminal_2, i.details.terminal_3, i.details.terminal_4, i.details.terminal_5, i.details.terminal_6, i.details.terminal_7],
    img: "/images/screenshots/terminal.png",
    icon: icon("terminal", { size: 28, stroke: accent }),
  },
  {
    id: "sftp",
    title: i.details.sftp_title,
    items: [i.details.sftp_1, i.details.sftp_2, i.details.sftp_3, i.details.sftp_4, i.details.sftp_5, i.details.sftp_6],
    img: "/images/screenshots/sftp.png",
    icon: icon("fileChart", { size: 28, stroke: accent }),
  },
  {
    id: "ide",
    title: i.details.ide_title,
    items: [i.details.ide_1, i.details.ide_2, i.details.ide_3, i.details.ide_4, i.details.ide_5, i.details.ide_6],
    img: "/images/screenshots/ide.png",
    icon: icon("code", { size: 28, stroke: accent }),
  },
  {
    id: "ai",
    title: i.details.ai_title,
    items: [i.details.ai_1, i.details.ai_2, i.details.ai_3, i.details.ai_4, i.details.ai_5],
    img: "/images/screenshots/ai.gif",
    icon: icon("bot", { size: 28, stroke: accent }),
  },
  {
    id: "forwarding",
    title: i.details.forwarding_title,
    items: [i.details.forwarding_1, i.details.forwarding_2, i.details.forwarding_3, i.details.forwarding_4, i.details.forwarding_5],
    img: "/images/screenshots/forwarding.png",
    icon: icon("link", { size: 28, stroke: accent }),
  },
];
---

<section class="site-section feature-tour">
  <div class="section-shell">
    <div class="section-head section-head--compact">
    <p class="section-head__label">
      {i.details.badge}
    </p>
    <h2>
      {i.details.title}
    </h2>
    </div>

    <div class="feature-tour__list">
      {features.map((feature, idx) => (
        <div class:list={[
          "feature-tour__item",
          idx % 2 !== 0 && "feature-tour__item--reverse",
        ]}>
          <!-- Text side -->
          <div class="feature-tour__copy">
            <div class="flex items-center gap-3 mb-4">
              <span aria-hidden="true" set:html={feature.icon} />
              <h3 class="text-2xl font-bold text-[var(--ot-text-primary)]">
                {feature.title}
              </h3>
            </div>
            <ul class="space-y-3">
              {feature.items.map((item) => (
                <li class="flex items-start gap-3 text-[var(--ot-text-secondary)]">
                  <span class="text-[var(--ot-accent)] mt-1 shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Image side -->
          <div class="feature-tour__media">
            <div class="screenshot-frame">
              <img
                src={feature.img}
                alt={feature.title}
                class="w-full h-auto"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
