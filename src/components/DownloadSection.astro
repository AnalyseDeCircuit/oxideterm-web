---
import type { LangKey } from "@/i18n";
import { t } from "@/i18n";
import { filledIcon } from "@/lib/icons";

interface Props {
  lang: LangKey;
}

const { lang } = Astro.props;
const i = t(lang);

const platforms = [
  {
    name: i.download.macos,
    icon: filledIcon("apple"),
    variants: [
      { label: i.download.apple_silicon, arch: "aarch64" },
      { label: i.download.intel, arch: "x64" },
    ],
  },
  {
    name: i.download.windows,
    icon: filledIcon("windows"),
    variants: [
      { label: i.download.x64, arch: "x64" },
      { label: i.download.arm64, arch: "arm64" },
    ],
  },
  {
    name: i.download.linux,
    icon: filledIcon("linux"),
    variants: [
      { label: i.download.x64, arch: "x64" },
      { label: i.download.arm64, arch: "arm64" },
    ],
  },
];
---

<section id="download" class="site-section download-workbench">
  <div class="section-shell section-shell--reading">
    <div class="section-head section-head--compact">
    <p class="section-head__label">
      {i.download.badge}
    </p>
    <h2>
      {i.download.title}
    </h2>
    <p>
      {i.download.subtitle}
    </p>
    <p class="download-workbench__requirements">
      {i.download.requirements}
    </p>
    </div>

    <div class="download-workbench__grid">
      {platforms.map((platform) => (
        <div class="download-workbench__platform">
          <div class="download-workbench__icon" set:html={platform.icon} />
          <h3>{platform.name}</h3>
          <div class="download-workbench__variants">
            {platform.variants.map((v) => (
              <a
                href="https://github.com/AnalyseDeCircuit/oxideterm/releases/latest"
                class="platform-btn"
              >
                {v.label}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <a
      href="https://github.com/AnalyseDeCircuit/oxideterm/releases"
      class="download-workbench__all-releases"
    >
      {i.download.all_releases} →
    </a>
  </div>
</section>
